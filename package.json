{
  "name": "web-audio-sidechain",
  "version": "0.1.0",
  "description": "Web Audio RMS sidechain ducking for background audio under TTS, with SpeechSynthesis fallback.",
  "type": "module",
  "license": "MIT",
  "author": "Roman Romanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atmoscheme/web-audio-sidechain.git"
  },
  "homepage": "https://github.com/atmoscheme/web-audio-sidechain#readme",
  "bugs": {
    "url": "https://github.com/atmoscheme/web-audio-sidechain/issues"
  },
  "keywords": [
    "web-audio",
    "web-audio-api",
    "sidechain",
    "ducking",
    "narration",
    "tts",
    "speech-synthesis",
    "rms",
    "audio-graph"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "demo:build": "npm run build && npm --prefix examples/vite-demo run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
